{
  "name": "mulitca-cost-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && vite build",
    "migrate": "node --env-file=.env dist/db/migrate.js",
    "start": "node --env-file=.env dist/server.js",
    "collect": "node --env-file=.env scripts/collect.mjs",
    "test": "vitest run --root .",
    "test:integration": "node --test test/integration.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "lucide-react": "0.468.0",
    "pg": "8.16.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/pg": "8.15.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "typescript": "5.8.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
